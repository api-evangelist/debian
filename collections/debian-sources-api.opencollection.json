{
  "opencollection": "1.0.0",
  "info": {
    "name": "Debian Bug Tracking System Bugs Sources API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search source code",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bugs.debian.org/search/:query",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Search source code"
        },
        {
          "info": {
            "name": "List all packages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bugs.debian.org/list"
          },
          "docs": "List all packages"
        },
        {
          "info": {
            "name": "List packages by prefix",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bugs.debian.org/prefix/:prefix",
            "params": [
              {
                "name": "prefix",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List packages by prefix"
        },
        {
          "info": {
            "name": "Get package info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bugs.debian.org/info/package/:package/:version",
            "params": [
              {
                "name": "package",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get package info"
        },
        {
          "info": {
            "name": "Browse source tree",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bugs.debian.org/src/:package/:version/:path",
            "params": [
              {
                "name": "package",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "path",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Browse source tree"
        },
        {
          "info": {
            "name": "Search by file checksum",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bugs.debian.org/sha256/",
            "params": [
              {
                "name": "checksum",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search by file checksum"
        },
        {
          "info": {
            "name": "Search by ctag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bugs.debian.org/ctag/",
            "params": [
              {
                "name": "ctag",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search by ctag"
        },
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bugs.debian.org/ping/"
          },
          "docs": "Health check"
        }
      ]
    }
  ],
  "bundled": true
}